+                num_blocks = cdiv(seq_len, page_size) if seq_len > 0 else 0
+                total_blocks += num_blocks
+                indptr_np[row_idx + 1] = total_blocks
+                last_page_len_np[row_idx] = (
+                    page_size
+                    if seq_len > 0 and seq_len % page_size == 0
+                    else seq_len % page_size
