+            with torch.no_grad():
+                source_weight = torch.cat(
+                    (
+                        source_weight[start : start + local_heads],
+                        source_weight[
+                            self.num_v_heads + start : self.num_v_heads
+                            + start
+                            + local_heads
+                        ],
+                    ),
+                    dim=0,
+                )
