+        local_heads = self.num_v_heads // self.tp_size
+        source_key = (
+            weight.data_ptr(),
+            tuple(weight.shape),
+            tuple(weight.stride()),
+            str(weight.device),
+            weight.dtype,
+            self.tp_rank,
+            self.disable_tp_for_ba_proj,
