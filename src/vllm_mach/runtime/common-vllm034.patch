+def use_mach_compiled_qwen35() -> bool:
+    """Use the compiled Qwen3.5 model when the SM120 Mach plugin is enabled."""
+    from vllm.platforms import current_platform
+
+    if not current_platform.is_cuda() or not current_platform.is_device_capability_family(120):
+        return False
+    plugins = environment_variables["VLLM_PLUGINS"]()
+    if plugins is not None:
+        return "mach" in plugins
+    if os.getenv("VLLM_MACH_PROFILE"):
+        return True
+    # With automatic plugin discovery, Mach registers its native backend only
+    # when the matching optional native package is installed.
+    from vllm_mach.mxfp6 import _optional_runtime_is_installed
+
+    return _optional_runtime_is_installed()
