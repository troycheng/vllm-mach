+    def run(
+        self,
+        force_num_sms = 0,
+        direct_output = False,
+        final_group_barrier = False,
+    ):
+        ext.exl3_mgemm_bf16_io(
+            self.a_bf16,
+            self.b_ptrs,
+            self.scratch,
+            self.output,
+            self.suh_ptrs,
+            self.a_had,
+            self.svh_ptrs,
+            self.bs[0].size(2) // 16,
+            force_num_sms,
+            self.output.size(1),
+            True,
+            direct_output,
+            final_group_barrier,
+        )
+
+    def run_grouped(
+        self,
+        force_num_sms = 0,
+        direct_output = False,
+        final_group_barrier = False,
+    ):
+        ext.exl3_mgemm_bf16_io_grouped_had(
+            self.a_bf16,
+            self.b_ptrs,
+            self.scratch,
+            self.output,
+            self.unique_suh_ptrs,
+            self.a_had_grouped,
+            self.svh_ptrs,
+            self.had_group_ids,
+            self.bs[0].size(2) // 16,
+            force_num_sms,
+            self.output.size(1),
+            True,
+            direct_output,
+            final_group_barrier,
+        )
+
+    def reference(self):
+        a_fp16 = self.a_bf16.to(torch.float16)
+        outputs = []
+        for b, svh in zip(self.bs, self.svhs):
+            a_had = torch.empty_like(a_fp16)
+            output = torch.empty(
