# Source from Bash after installing the matching development wheel, native
# lossless package 0.1.0a4 and both prefill caller patches.
source "$(dirname "${BASH_SOURCE[0]}")/qwen38-checkpoint-temporal.env"
export VLLM_MACH_LOSSLESS_PREFILL=1
export VLLM_MACH_LOSSLESS_PREFILL_SUM=1
export VLLM_MACH_LOSSLESS_PREFILL_DIRECT=1
export VLLM_MACH_LOSSLESS_PREFILL_LONG=1
export VLLM_MACH_BA_OVERLAP=1
export VLLM_MACH_LOSSLESS_PREFILL_VERIFY=0
export VLLM_MACH_BA_OVERLAP_VERIFY=0
