# Source after installing the documented native dependencies and runtime patches.
# Set VLLM_MACH_MXFP6_CHECKPOINT to the paired original MXFP6 checkpoint.
export VLLM_PLUGINS=mach
export VLLM_MACH_EXL3_MXFP6_PROFILE=qwen38-27b-checkpoint
export VLLM_EXL3_GRAPH_DECODE=1
export EXL3_QKV_MGEMM=1
export EXL3_BF16_IO=1
export EXL3_BF16_IO_M24=1
export EXL3_BF16_IO_M32=1
export EXL3_TEMPORAL_QKV_M24=1
export VLLM_MACH_EXL3_MXFP6_FUSED_AR_NORM_MXFP8=1
export VLLM_FLASHINFER_ALLREDUCE_BACKEND=trtllm
export VLLM_MACH_SAMPLING_DEVICE_METADATA=1
export VLLM_ENABLE_QWEN_GDN_FUSED_DECODE=1
export MXFP6_AUTOTUNE=off
export VLLM_EXL3_EMBED_ONLINE_BITS=6
export VLLM_EXL3_B12X_MIN_M=128
export VLLM_EXL3_B12X_N_RANGE=5120-36864
export VLLM_EXL3_B12X_ANY_BITS=1
export B12X_PACKED_B_MIN_N=1024
export VLLM_EXL3_PREFILL_FUSED_RECONSTRUCT_MIN_M=128
export VLLM_EXL3_PREFILL_RECONSTRUCT_CACHE=0
export VLLM_EXL3_PREFILL_RECONSTRUCT_MAX_MB=512
